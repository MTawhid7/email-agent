# ── Gemini ────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-3.1-flash-lite

# ── Gmail ─────────────────────────────────────────────────────────────────────
# Download from Google Cloud Console → APIs & Services → Credentials
GMAIL_CREDENTIALS_PATH=credentials/credentials.json

# How often (seconds) the daemon checks for new emails
POLL_INTERVAL_SECONDS=300

# ── AI Persona ────────────────────────────────────────────────────────────────
# Full instructions for how the agent should reply. Be as specific as you like.
PERSONA_PROMPT=You are a professional and concise email assistant. Address the sender by first name. Keep replies brief and actionable.

# ── Signature ─────────────────────────────────────────────────────────────────
SIGNATURE_NAME=Your Name
SIGNATURE_TITLE=Your Title
SIGNATURE_COMPANY=Your Company
SIGNATURE_PHONE=+1 (555) 000-0000
SIGNATURE_LINKEDIN=https://linkedin.com/in/yourhandle
SIGNATURE_GITHUB=https://github.com/yourhandle
SIGNATURE_WEBSITE=https://yourwebsite.com
